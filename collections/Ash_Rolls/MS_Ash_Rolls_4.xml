               <msContents>
                  <msItem class="#heraldica"  xml:id="MS_Ash_Rolls_4-item1">
                     <title key="work_11050" type="desc">Roll of arms (‘The Ashmolean Roll’) </title>
                     <listBibl><bibl>A. R. Wagner, <title>A Catalogue of English Medieval Rolls of Arms </title>pp. 57-8</bibl></listBibl>
                     <textLang mainLang="xno">Anglo-Norman</textLang>
                  </msItem>
                 
                  <msItem class="#historica"  xml:id="MS_Ash_Rolls_4-item3">
                     <locus>(m. 1 dorse)</locus>
                     <title type="desc">Coats of arms with blazon in English (varieties of lion, cross, etc.)</title>
                     <textLang mainLang="enm">Middle English</textLang>
                  </msItem>
                  <msItem class="#historica"  xml:id="MS_Ash_Rolls_4-item3a">
                     <locus>(mm. 2-3 dorse)</locus>
                     <title key="work_15057">Treatise on heraldry (‘The Ashmolean Tract’ or ‘John's Treatise’)</title>
                     <note>Preceded by a collection of heraldic charges.</note>
                     <textLang mainLang="enm">Middle English</textLang>
                  </msItem>
                  <msItem class="#heraldica"  xml:id="MS_Ash_Rolls_4-item3b">
                     <locus>(m. 4 dorse)</locus>
                     <title  type="desc">The Earl Marshal's fees at a coronation </title>
                     <incipit>Le countie Mareschall doit aver le palfrey le roy oue tout le harneis</incipit>
                     <note>Added, 16th century</note>
                     <textLang mainLang="xno">Anglo-Norman</textLang>
                  </msItem>
                  
                  <msItem class="#historica"  xml:id="MS_Ash_Rolls_4-item4">
                     <locus>(dorse)</locus>
                     <title key="work_12970" type="desc">List of earls, lords, and knights at an unknown occasion</title>
                     <note>The first name is "erle of Huntyngtone", the last "Sir Ric' Tempasse".</note>
                     <textLang mainLang="enm">Middle English</textLang>
                  </msItem>
                  <msItem class="#heraldica"  xml:id="MS_Ash_Rolls_4-item34a">
                     <locus>(dorse)</locus>
                     <title  type="desc">Parish churches, knights' fees, etc., in England </title>
                     <note>Added, 16th century, same hand as m. 4 dorse.</note>
                     <textLang mainLang="la">Latin </textLang>
                  </msItem>
