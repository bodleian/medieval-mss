                     <msContents>
                        <textLang mainLang="it">Italian</textLang>
                        <msItem>
                           <locus>(fol. 1)</locus>
                           <note>Letter from <persName key="person_37029945">Cardinal Reginald Pole</persName> to <persName>Cardinal Rodolfo Pio of Carpi</persName> "legato del Patrimonio", Bagnoregio, 19 July 1552. Autograph signature.</note>
                        </msItem>
                     </msContents>
