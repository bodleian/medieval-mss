                        </origin>
                        <provenance>Bought from Renzo Rizzi, Libri antichi, Milan</provenance>
                     </history>
                  </msPart>
                  
                  <msPart xml:id="MS-Ital-c-74-B" n="B">
                     <msIdentifier><altIdentifier>
                   <idno>MS. Ital. c. 74 – Part B</idno>     </altIdentifier>
                     </msIdentifier>
                     
                     <msContents>
                        <summary>Original letters addressed to <persName key="person_27456375">Benedetto Dei of Florence</persName>.</summary>
                        <textLang mainLang="it">Italian</textLang>
                        <msItem n="i">
                           <locus>(fol. 2)</locus>
                           <note>"Riccordo ad voi Benedecto de del vostro <persName>Jacopo Acciaiuoli</persName>". Undated (a note by Dei on the back about a sale is dated May 1486). List of people to whom Acciaiuoli wishes to be recommended by Dei in Bologna, Ferrara, Modena, Mantua and Milan.  </note>
                        </msItem>
                        
                        <msItem n="ii">
                           <locus>(fol. 3)</locus>
                           <note> From <persName>Prospero Adorno of Genoa</persName>, Asti (?), 6 Sept. 1482. Wafer seal.</note>
                        </msItem>
                        
                        <msItem n="iii">
                           <locus>(fol. 4)</locus>
                           <note>From <persName key="person_56592841">Donato Acciaiuoli, podestà in Pisa</persName>, 21 March 1475/6.</note>
                           <note>Script attributed to <persName role="scr" key="person_5189">Petrus Francescus de San Miniato</persName>, Acciaiuoli's secretary (D. F. S. Thomson, ‘The Codex Romanus of Catullus: A Collation of the Text’, <title>Rheinisches Museum Für Philologie</title>, 113.2/3 (1970), pp. 97–110 (p. 99 n. 10)
                           </note><!-- https://www.persee.fr/doc/scrip_0036-9772_1974_num_28_2_1081 no. 1017 -->
                        </msItem>
                        
                        <msItem n="iv">
                           <locus>(fol. 5)</locus>
                           <note>From <persName>Galeotto Capponi</persName>, Venice (?), 16 July (?) 1487.</note>
                        </msItem>
                        
                        <msItem n="v">
                           <locus>(fol. 6)</locus>
                           <note>From <persName>Francesco Capponi</persName>, Rome, 3 Jan. 1488/9.</note>
                        </msItem>
                        
                        <msItem n="vi">
                           <locus>(fol. 7)</locus>
                           <note>From <persName>Tommaso di Capponi</persName>, Rome (?), 12 July 1488.</note>
                        </msItem>
                        
                        <msItem n="vii">
                           <locus>(fol. 8)</locus>
                           <note>From <persName>Tommaso di Gino Capponi</persName> in Spain (?), 3 Sept. 1491.</note>
                        </msItem>
                        
                        <msItem n="viii">
                           <locus>(fol. 9)</locus>
                           <note>From <persName>Franciscus Carcherellis (?) de Florentia</persName> "conest' in casto [Colle]",  9 Aug. 1453.</note>
                        </msItem>
                        
                        <msItem n="ix">
                           <locus>(fol. 10)</locus>
                           <note>From <persName>Andrea Carducci</persName>, Florence, 9 Oct. 1453. </note>
                        </msItem>
                        
