               <msContents>
                  
                  <msItem class="#liturgica" n="1" xml:id="MS_Canon_Liturg_347-item1">
                     <title key="work_13111" type="desc">Manual (Franciscan)</title>
                     <textLang mainLang="la">Latin</textLang>
                  </msItem>
                  <msItem class="#legalia #ecclesiastica" n="2" xml:id="MS_Canon_Liturg_347-item2">
                     <title key="work_13688" type="desc">Papal constitutions</title>
                     
                     <msItem>
                        <locus>(fol. 1v)</locus>
                        <title type="desc">Reception into the Order</title>
                     </msItem>
                     
                     <msItem>
                        <locus>(fol. 6r)</locus>
                        <title type="desc">Formulas of profession</title>
                        <note>In Latin and Italian</note>
                     </msItem>
                     
                     <msItem>
                        <locus>(fols 7r, 16r)</locus>
                        <title type="desc">Rule of the Third Order according to Nicholas IV</title>
                        <note>In Latin</note>
                     </msItem>
                     
                     <msItem>
                        <locus>(fols 17r, 29v)</locus>
                        <title type="desc">Rule of the Third Order according to Nicholas IV</title>
                        <note>In Italian</note>
                     </msItem>
                     
                     <msItem>
                        <title type="desc">Letter of Clement in favour of the Continentes ('Cordis est nobis quidem')</title>
                     </msItem>
                     
                     <msItem>
                        <locus>(fol. 30r)</locus>
                        <title type="desc">List of plenary indulgences</title>
                        <incipit>Indulgentie plenarie que habentur in quibusdam ecclesiis principalibus in urbe Roma... quas sanctissimus pontifex Sixtus papa 
                           quartus concessit imperpetuum venerabilibus religiosis sororibus Tertii Ordinis beati Francisci habitantibus in loco seu monasterio 
                           sancti Onofrii alias de Fuligno. In ciuitate Florentie... anno Domini MCCCCºlxxvj. die. xii. mensis Julij</incipit>
                        <note>Given to the nuns of St Humphrey of Foligno at Florence in 1476</note>
                        
                     </msItem>
                     
                     <msItem>
                        <locus>(fols 33, 34, 37v)</locus>
                        <title type="desc">Ritual of the Last Sacraments</title>
                     </msItem>
                     
                     <msItem>
                        <locus>(fol. 37v)</locus>
                        <note>Ordo commendationis anime</note>
                     </msItem>
                     
                     <msItem>
                        <locus>(fol. 42v)</locus>
                        <title type="desc">Formula of plenary indulgence in the hour of death</title>
                     </msItem>
                     
                     <msItem>
                        <locus>(fol. 45r)</locus>
                        <title type="desc">Slightly later constitutions for the conventual life of the nuns</title>
                        <incipit>... li Ordini che anno a obseruare tutte quelle saranno acceptate in nostra congregatione</incipit>
                        <note>In Italian</note>
                     </msItem>
                     
                     <msItem>
                        <title type="desc">Later additions</title>
                     </msItem>
                     <textLang mainLang="la" otherLangs="it">Latin and Italian</textLang>
                  </msItem>
                  
