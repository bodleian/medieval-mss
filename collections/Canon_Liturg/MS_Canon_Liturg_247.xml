                     <origPlace>
                        <country key="place_1000080">Italy</country>, <settlement key="place_7018159">Venice</settlement>, Diocese of <placeName key="place_7003038">Torcello</placeName>(?)
                        <!--ORIGINAL: Italian, Venice-->
