               <history>
                  <origin>
                     <origDate calendar="Gregorian" notAfter="1460" notBefore="1440">15th century, middle</origDate>
                     <origPlace>
                        <country key="place_1000080">Italy</country>, <region>Lombardy</region>, <settlement key="place_7005764">Brescia</settlement>, 
                        <!--ORIGINAL: Italian, Lombardy-->
                     </origPlace>
                  </origin>
                  
                  <provenance>'Sancte Seq̄nti [Secundus?, not Sequentius] ora' is twice (fol. 123r and fol. 123v) in the list of saints in the Litany</provenance>
                  <provenance>In the Calendar, St Anthony of Padua is in red</provenance>
                  <provenance>Some illuminated initials (e. g. fol. 52r, fol. 58r, fol. 64r and fol. 86r) have Franciscan saints</provenance>
                  <provenance> In the Collect for the 'pontifex' is the initial <hi rend="bold">I</hi> (128v)
                  </provenance>
                  
                  <provenance>On fol. 14r are the arms: or an eagle displayed gules. Perhaps Martinengo of Brescia</provenance>
                  
                  <provenance><persName key="person_2384880" role="fmo">Matteo Luigi Canonici (1727– <hi rend="italic">c</hi>. 1806)</persName></provenance>
                  <provenance notAfter="1807" resp="#SC">Following Canonici's death, the collection passed to his brother, <persName key="person_446" role="fmo">Giuseppe Canonici</persName>, and 
                     then to Canonici's nephew, <persName role="fmo" key="person_431">Giovanni Perissinotti</persName>, in 1807 following Giuseppe Canonici's death</provenance>
                  <acquisition when="1817">Bought by the Bodleian Library in 1817 from Giovanni Perissinotti. On the purchase, see <ref target="https://digital.bodleian.ox.ac.uk/collections/canonici/">Digital Bodleian</ref></acquisition>
                  
               </history>
