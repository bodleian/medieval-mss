               <msContents>  <textLang mainLang="la">Latin</textLang>
                  <msItem n="1">
                     <locus>fol. 1r</locus>
                     <title type="desc" key="work_14992">Commentary on the verse computus 'Filio esto dei'</title>
                     <incipit>Compotus iste dividitur in sex partes</incipit>
                     <finalRubric>Explicit compotus manualis secundum usum Cantebrig. quod <persName role="scr" key="person_5198">Bernys</persName> scripsit.</finalRubric>
                   
                     <note type="addenda">See Wordsworth, <title>Kalendar</title>, 119, 253. Cf. MS. Digby 48 fols. 21–8v which has the same incipit but a text with many differences. </note><listBibl><bibl>TK 244.</bibl></listBibl></msItem>
                  <msItem n="2">
                     <locus>fol. 11r</locus>
                     <author key="person_2583890">Alexander de Villa Dei</author>
                     <title key="work_409">Carmen de algorismo</title>
                     <incipit>Hec algorismus ars presens dicitur, in qua</incipit>
                     <explicit>Multiplicandorum de normis sufficiunt hec.</explicit>
                     <finalRubric>Explicit tractus algorismi, etc.</finalRubric>
                     <note type="addenda">TK 597.</note></msItem>
                  <msItem n="3">
                     <locus>fol. 19r</locus>
                     <author key="person_84975906">Johannes de Sacrobosco</author>
                     <title key="work_2592">Tractatus de sphaera</title>
                     <incipit>Tractatum de spera in quatuor partes dividimus.</incipit>
                     <explicit>aut Deus nature patitur aut mundana machina dissolvetur. Ex quibus exiliter dictis evidet intuenti formam mundialis machine, una cum singulorum particulis superius principaliter intentorum ...</explicit>
                     <note type="addenda">Ed. L. Thorndike (Chicago, 1949). </note><listBibl><bibl>TK 1577.</bibl></listBibl></msItem>
                  <msItem n="4">
                     <locus>fol. 58r</locus>
                     <author key="person_77138678">Walter Brytte</author>
                     <title key="work_4937">Commentary on Theorica planetarum</title>
                     <incipit>Circulus ecentricus egresse cuspidis, et circulus egredientis centri sunt idem.</incipit>
                     <explicit>et ideo luna non retrograditur et istius <unclear>canoni</unclear> subditur, etc. </explicit><finalRubric>Explicit Theorica domini Walteri Brit, quondam socii collegii de Merton ...</finalRubric>
                     <note>Followed by diagrams of planetary motions.</note>
                     <note type="addenda">The same work is in MSS. Digby 48 (art. 8), Digby 93 (art. 6) and Digby 98 (art. 24) and is usually ascribed to Simon Bredon (sic Weisheipl, ‘Repertorium’, 183, no. 4). O. Pedersen, ‘The problem of Walter Brytte and Merton astronomy’, <title>Archives internationales d’histoire des sciences</title>, 36 (1986), 227–8, argues, however, that the author is Brytte (probably of Oxford but lacking any apparent Merton connection and not to be confused with the Welsh Walter Brit recorded by Emden, <title>BRUO</title>). This is one of three manuscripts of the eight recorded by Pedersen that ascribes the work to Brytte. </note><listBibl><bibl>TK 223.</bibl></listBibl></msItem>
                  <msItem n="5">
                     <locus>fols. 98r–112r</locus>
                     <title key="work_10687" type="desc">Calendar with astronomical material included tables and diagrams of eclipses</title>
                     <note>The dedication of St Mary, Eton is at 21 June.</note>
                     <note type="addenda">The calendar is for the use of Cambridge; van Dijk, <title>Latin Liturgical MSS.</title>, 3. 189.</note></msItem>
                  <msItem n="6">
                     <locus>fol. 113r</locus>
                     <title key="work_14518" type="desc">Science: optics (de luce et visu)</title>
                     <incipit>Prima conclusio experimentalis ex Alycen quod lux habet aliquam operationem in visum.</incipit>
                     <explicit>pars autem una istuc, pars autem ultra illuc, vertitur.</explicit>
                     </msItem><!-- not in In Principio -->
                  <msItem n="7">
                     <locus>fol. 122r</locus>
                     <title type="desc" key="work_13156">Mathematics: de numeris absolutis</title>
                     <incipit>Primo queritur an sint certe regule sub certis ordinibus posite ex quibus numeri absoluti procreantur.</incipit>
                     <explicit>non faciunt numeros contra se positos, quod tamen sequitur ex regula Boicii ibidem.</explicit>
                    </msItem><!-- not in In Principio -->
                  <msItem n="8">
                     <locus>fol. 129r</locus><author key="person_305360068">Ps.-Cicero</author>
                     <title key="work_3976">Rhetorica ad Herennium</title>
                     <note>Short extracts from books 1-4.</note>
                     <incipit>Oratoris officium est de hiis rebus posse dicere</incipit>
                     <!-- MLH identification -->
                  </msItem>
                  <msItem n="9">
                     <locus>fol. 133v</locus>
                     <author key="person_31966811">Jordanus de Nemore</author>
                     <title key="work_2865">De ratione ponderis</title>
                     <note type="addenda">Suppositiones and praepositiones, R1.01–10, R3.03–04, R4.01–16 only, ed. by Moody &amp; Clagett, <title>Weights</title>, 173–227, not noting this manuscript. </note><listBibl><bibl>R. B. Thomson, ‘Jordanus de Nemore: Opera’, <title>Mediaeval Studies</title>, 38 (1976), 97–144 lists many other copies but not this. </bibl><bibl>TK 1000.</bibl></listBibl></msItem>
                  
                  
                  
