               <msContents>
                  <msItem class="#liturgica" xml:id="MS_Liturg_299-item1">
                     <locus from="1r" to="87v" type="inferred"/>
                     <title key="work_10579" type="desc">Book of Hours, Use of Sarum</title>
                     <note>Mutilated. All parts are incomplete. Leaves missing after fols. 7a, 10, 11, 15,
                        22, 23, 24, 25, 27, 30, 37, 43, 54, 69, 77, 80</note>

                     <msItem>

                        <note>Calendar (fol. 1)</note>
                     </msItem>
                     <msItem>

                        <note>Fifteen O’s (fol. 7b)</note>
                     </msItem>
                     <msItem>

                        <note>Joys of St John tbe baptist (fol. 11)</note>
                     </msItem>
                     <msItem>

                        <note>Office of the Virgin (fol. 12) with the Hours of the Cross worked
                           in</note>
                     </msItem>
                     <msItem>

                        <note>Troped Salve regina (fol. 29v)</note>
                     </msItem>
                     <msItem>

                        <note>Paraphrase of the Salve regina (fol. 30v)</note>
                     </msItem>
                     <msItem>

                        <note>O intemerata (fol. 33v)</note>
                     </msItem>
                     <msItem>

                        <note>Obsecro (fol. 34v)</note>
                     </msItem>
                     <msItem>

                        <note>Seven Joys (fol. 36: Virgo templum)</note>
                     </msItem>
                     <msItem>

                        <note>Devotions of the Five Wounds (fol. 38) and the Seven Words ('Oracio uenerabilis Bede de Septem Verbis Christi ') (fol.
                           39v)</note>
                     </msItem>
                     <msItem>

                        <note>Salutations (fol. 41: Precor te piissime domine J.C., Ave domine I.C.
                           verbum, Ave verum, Ave caro, Anima Christi, Domine J.C. qui hanc, Deus
                           propitius esto michi, etc.)</note>
                     </msItem>
                     <msItem>

                        <note>Penitential (fol. 44) and Gradual (fol. 48) Psalms with the litany
                           (fol. 49v)</note>
                     </msItem>
                     <msItem>

                        <note>Office of the dead (fol. 55) and commendation (fol. 70)</note>
                     </msItem>
                     <msItem>

                        <note>Psalms of the passion (fol. 78)</note>
                     </msItem>
                     <msItem>

                        <note>Psalter of St Jerome (fol. 80v). Additional suffrage pro pestilentia
                           et fame (fol. 87: Stella celi extirpavit). </note>
                     </msItem>
                    

                     <textLang mainLang="la">Latin</textLang>
                  </msItem>
