               <msContents>
                  <msItem class="#liturgica" n="1" xml:id="MS_Liturg_184-item1"><locus from="1r" to="110v" type="inferred"/>
                     <title key="work_10579" type="desc">Book of Hours, Use of Sarum</title>
                     <msItem>
                        <note>Calendar (fol. 1) graded with feasts of three and nine lessons</note>
                     </msItem>
                     <msItem>
                        <note>Prayers, commemorations and Joys (fol. 7)</note>
                     </msItem>
                     <msItem>
                        <note>Office of the Virgin (fol. 29) with the Hours of the Cross worked in. Among the memoriae in Lauds is one 'de sanctis reliquiis', 'in hac ecclesia'.</note>
                     </msItem>
                     <msItem>
                        <note>Troped Salve regina (fol. 60v)</note>
                     </msItem>
                     <msItem>
                        <note>Penitential (fol. 62) and Gradual (fol. 68v) Psalms with the litany (fol. 70)</note>
                     </msItem>
                     <msItem>
                        <note>Office of the dead (fol. 76) and commendation (fol. 95)</note>
                     </msItem>
                     <msItem>
                        <note>Psalms of the passion (fol. 106), incomplete.</note>
                     </msItem>
                     <textLang mainLang="la" otherLangs="enm">Latin with Middle English rubrics at fols. 19r ('A feyr prayer to seynt thomas of cantirbere') and 81v ('God gouerne in psalmis')</textLang>
                  </msItem>
               </msContents>
