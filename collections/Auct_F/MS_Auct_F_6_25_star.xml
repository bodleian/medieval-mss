                     <msItem class="#liturgica">
                        <title key="work_12558" type="desc">Lectionary</title>
                        <note>(fragment)</note>
                        <note>The surviving portion contains lessons appointed for Palm Sunday
                           (Philippians 4:4–9), Holy Thursday (1 Corinthians 11:23–32), and Holy
                           Friday Vespers (1 Corinthians 1:18–2:2).</note>
                        <note>The surviving text begins on fol. 3v.</note>
                        <textLang mainLang="grc">Greek</textLang>
                     </msItem>
                  </msContents>

