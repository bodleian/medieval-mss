               <head>Guardbook of fragments, comprising leaves from at least 11 different Greek
                  manuscripts; 15th–17th century.</head>

               <physDesc>
                  <p n="composite"> Guardbook of fragments, comprising leaves from at least 11
                     different Greek manuscripts, dating from the 15th to the 17th century. Units: I
                     (fols. 1–74) || II (fols. 75–126) || III (fols. 127–156) || IV (fols. 157–180)
                     || V (fols. 181–208) || VI (fols. 209–225) || VII (fols. 226–230) || VIII
                     (fols. 231–251) || IX (fols. 252–259) || X (fols. 260–268) || XI (fols.
                     269–272). </p>
                  <objectDesc form="codex">
                     <supportDesc material="chart">
                        <support>paper</support>
                        <extent>
                           <measure type="leaf">272</measure> leaves. <dimensions type="leaf"
                              unit="mm">
                              <height>210</height>
                              <width>130</width>
                           </dimensions>
                        </extent>
                     </supportDesc>
                  </objectDesc>



                  <bindingDesc>
                     <binding notBefore="1700" notAfter="1799">
                        <p>Brown half-leather binding.</p>
                     </binding>
                  </bindingDesc>
               </physDesc>

