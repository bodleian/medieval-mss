                     <msItem n="1">
                        <title>Religious Poetry in Classical Verses</title>

                        <msItem n="1a">
                           <locus from="1" to="2v">fols. 1r–2v</locus>
                           <title>On the Dormition of the Virgin</title>
                           <title>On the Dormition of the Virgin</title>
                           <title xml:lang="grc">Εἰς τὴν τῆς παρθένου μετάστασιν ποίημα</title>
                           <incipit xml:lang="grc">Ὑμνοῦμεν Μαρίας μόρον ἄμωρον ὅτε
                              θανοῦσα</incipit>
                        </msItem>
                        <msItem n="1b">
                           <locus from="2v" to="4v">ff. 2v–4v</locus>
                           <title>On the Dormition of the Virgin</title>
                           <title xml:lang="grc">Εἰς τὴν τῆς παρθένου μετάστασιν ποίημα</title>
                           <incipit xml:lang="grc">Μνήσομαι οὔτε θανώμαι</incipit>
                        </msItem>
                        <msItem n="1c">
                           <locus from="5r" to="7r">ff. 5r–7r</locus>
                           <title>On the Dormition of the Theotokos.</title>
                           <title xml:lang="grc">Εἰς τὴν μετάστασιν τῆς Θεομήτορος, τὸ καὶ θανάτου
                              τρόπαιον</title>
                           <incipit xml:lang="grc">Μοίρης μελοβέλεσσι ἀειπαρθένος ἔριπε μήτηρ
                           </incipit>
                        </msItem>
                        <msItem n="1d">
                           <locus from="8r" to="11v">ff. 8r–11v</locus>
                           <title>On the Nativity of Christ, a heroic poem</title>
                           <title xml:lang="grc">Εἰς τὸ γέννημα τοῦ Χριστοῦ, ἡρωικὸν ποίημα</title>
                           <incipit xml:lang="grc">Εἶπε θεὰ βαθύπολκον...</incipit>
                        </msItem>
                        <msItem n="1e">
                           <locus from="12r" to="12v">ff. 12r–12v</locus>
                           <title>On the Virgin</title>
                           <title xml:lang="grc">Εἰς τὴν Παρθένον</title>
                           <incipit xml:lang="grc">Κράτα φίλον τριμακάριον</incipit>
                        </msItem>
                        <msItem n="1f">
                           <locus from="13r" to="14r">ff. 13r–14r</locus>
                           <title>On the Theotokos</title>
                           <title xml:lang="grc">Εἰς τὴν Θεοτόκον</title>
                           <incipit xml:lang="grc">Αὐθί τοι, ὦ τριμακαίρα, γενέθλιον ὕμνον
                              ἀείσω</incipit>
                        </msItem>
                        <msItem n="1g">
                           <locus from="15r" to="17v">ff. 15r–17v</locus>
                           <title>On the Dormition</title>
                           <incipit xml:lang="grc">ὦ Χάρις, ὦ τί μέλος θυμάμενον</incipit>
                           <note> The poem is also found in Jerusalem, Patriarchal Library, MS 616,
                              ff. 50r–52v, where it is doubtfully attributed to Joannes
                              Kariophylles. See Athanasios Papadopoulos-Kerameus, <title level="m"
                                 >Hierosolymitikē bibliothēkē</title>, vol. 2 (1894), . <ref
                                 target="https://www.google.co.uk/books/edition/Hierosolymitik%C4%93_biblioth%C4%93k%C4%93/9oYqAAAAMAAJ?hl=en&amp;gbpv=1&amp;dq=%22%CE%9C%CE%B5%CF%84%CE%AC%CF%83%CF%84%CE%B1%CF%83%CE%B9%CE%BD+%CF%84%E1%BF%86%CF%82+%CE%A0%CE%B1%CF%81%CE%B8%CE%AD%CE%BD%CE%BF%CF%85%22+%CF%80%CE%BF%CE%AF%CE%B7%CE%BC%CE%B1&amp;pg=PA617&amp;printsec=frontcover"
                                 >p. 617</ref>. </note>
                        </msItem>
                        <msItem n="1h">
                           <locus from="18r" to="22r">ff. 18r–22r</locus>
                           <title>Metrical Passion of St Andrew of Chios (d. 1465)</title>
                           <title xml:lang="grc">Μαρτύριον τοῦ ἁγίου Ἀνδρέου τοῦ μάρτυρος</title>
                           <incipit xml:lang="grc">Ἀνδρέας ὁ πρωτόκλητος, ὁ πρῶτος θεοῦ
                              κήρυξ</incipit>
                           <note>
                              <ref
                                 target="https://clavis.brepols.net/clacla/OA/Details.aspx?id=129BF4EE4D1D4F2D83C06058F37767DA"
                                 >BHG-2024d</ref>
                           </note>
                           <bibl>Spyridon Lampros, <title level="a">Ἔμμετρον μαρτύριον τοῦ κοιμάσεως
                                 Ἀνδρέου καὶ δημώδης Ὁμιλία</title>, <title level="j">Νέος
                                 Ἑλληνομνήμων</title> 12 (1915), pp. 378–379. </bibl>
                        </msItem>

                        <msItem n="1g">
                           <locus from="23" to="25">fols. 23–25</locus>
                           <title>Untitled poem on the Nativity</title>
                           <incipit xml:lang="grc">Ὀφθαλμοί τι τὸ θαῦμα τεράστιον εἶδος
                              λαλεῖ.</incipit>
                        </msItem>
                        <msItem n="1i">
                           <locus from="26r" to="27v">ff. 26r–27v</locus>
                           <title>Poem on the Nativity of Christ</title>
                           <incipit xml:lang="grc">Ἔννεπε Καλλιόπεια γενέθλια</incipit>
                        </msItem>
                        <msItem n="1j">
                           <locus from="27v" to="31r">ff. 27v–31r</locus>
                           <title>Poem on the Nativity of Christ</title>
                           <title xml:lang="grc">Μικροῦ Χριστιδίου γενέθλιον ἦμαρ ἀείσω</title>
                           <incipit xml:lang="grc">Μικυλὰ πάππα, ζῶντος ἐπουλλία, τέττα
                              βαβάζων</incipit>
                           <note>The closes with the name of Joannes Damesianus as a possible
                              author.</note>
                        </msItem>
                        <msItem n="1k">
                           <locus from="32r" to="34r">ff. 32r–34r</locus>
                           <title>Homily on the Dormition</title>
                           <incipit xml:lang="grc">Στεφανώσωμεν κάτω καὶ ἡμεῖς</incipit>
                           <explicit xml:lang="grc">τοὺς ποντοποροῦντας τοῦ βίου τὴν
                              θάλατταν.</explicit>
                           <note>
                              <ref
                                 target="https://clavis.brepols.net/clacla/OA/Details.aspx?id=97747C57D85146C2955AD339CD006D08"
                                 >BHG 1141s</ref>
                           </note>
                        </msItem>



                        <msItem n="1l">
                           <locus from="36r" to="39r">fols. 36r–39r</locus>
                           <title>Metrical Homily on the Virgin</title>
                           <title xml:lang="grc">Γρηγόριος ὁ Γρηγοριώτατος τῆς παρθενίας
                              ὀφθαλμός</title>
                           <incipit xml:lang="grc">Ὠ καλῶν τῶν πραγμάτων φοράς...</incipit>
                        </msItem>
                        <msItem n="1m">
                           <locus from="40r" to="42v">ff. 40r–42v</locus>
                           <title>Homily on St Athanasius</title>
                           <incipit xml:lang="grc">Ἡ κατʼ ἔτος τῶν ἐπʼ ἀρετῇ καὶ βίου σεμνότητι
                              διαπρεψάντων</incipit>
                           <explicit xml:lang="grc">εἶθʼ οὕτως τῶν ἐκεῖσε καλῶν ἐν ἀφθονίᾳ
                              κατατρυφᾶν.</explicit>
                           <note>
                              <ref
                                 target="https://clavis.brepols.net/clacla/OA/Details.aspx?id=A98158C5CCBB469C9B2D999A58C81ABE"
                                 >BHG 186c</ref>
                           </note>
                        </msItem>

                        <msItem n="3β">
                           <locus from="40" to="43">fols. 40–43</locus>
                           <title>Oration of Athanasius</title>
                        </msItem>

                        <msItem n="3δ">
                           <locus from="44" to="46">fols. 44–46</locus>
                           <title>On Saint Gregory Nazianzen</title>
                        </msItem>

                        <msItem n="3ε">
                           <locus from="47" to="48">fols. 47–48</locus>
                           <title>On the Nativity of Christ</title>
                        </msItem>

                        <msItem n="3ζ">
                           <locus from="49" to="50">fols. 49–50</locus>
                           <title>On Gregory the Theologian</title>
                        </msItem>

                        <msItem n="3η">
                           <locus from="51" to="54">fols. 51–54</locus>
                           <title>Homily of Basil, bishop of Seleucia, on Thomas the Apostle</title>
                        </msItem>

                        <msItem n="3θ">
                           <locus from="55" to="56">fols. 55–56</locus>
                           <title>Homily of the same author on Holy Pentecost</title>
                        </msItem>

                        <msItem n="3ι">
                           <locus from="57" to="63">fols. 57–63</locus>
                           <title>Untitled work on the Dormition of the Blessed Virgin Mary</title>
                           <incipit xml:lang="grc">τί τοῦτο, ὦ πάροντες, τί τοῦτο;</incipit>
                        </msItem>

                        <msItem n="3κ">
                           <locus from="64" to="68">fols. 64–68</locus>
                           <title>On the divine Athanasius</title>
                        </msItem>

                        <msItem n="3μ">
                           <locus from="69" to="74">fols. 69–74</locus>
                           <title>Fourth Sunday of Lent</title>
                           <note>Begins: “Teach me, my son, another spirit towards you …”</note>
                        </msItem>
                     </msItem>
