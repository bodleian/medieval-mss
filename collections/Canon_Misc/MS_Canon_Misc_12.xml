               <msContents><textLang mainLang="la">Latin</textLang>
                 

                  <msItem n="1" xml:id="MS_Canon_Misc_12-item1">
                     <locus from="1r">fol. 1r</locus>
                     <author key="person_39382430">Francesco Petrarca</author>
                     <title key="work_3566">Psalmi poenitentiales</title>
                  </msItem>
                  <msItem n="2" xml:id="MS_Canon_Misc_12-item2">
                     <locus from="5v">fol. 5v</locus>
                     <author key="person_79253953">Gasparino Barzizza</author>
                     <title key="work_7557">De compositione siue de tribus partibus elocutionis</title>
                    
                     <incipit>Cum omnis commode et perfecte elocutionis praeceptio.</incipit>
                     <explicit>ut elocutionis dignitatem perturbabit.</explicit>
                     <finalRubric>Explicit; Deo gratias: Cremone, 13 die Decembris 1449, tractatus
                        iste expletus fuit.</finalRubric>
                     <listBibl><bibl>Bertalot, <title>Prosa</title>, 3726</bibl></listBibl>
                     <note>The same hand continues to fol. 14 where another hand takes over to complete the first section of the volume, ending with four blank leaves at fol. 20. </note></msItem>
                  <msItem  xml:id="MS_Canon_Misc_12-item2a">
                     <note>Followed by a hymn attributed to <persName role="aut" key="person_17232779">Maffeo Vegio</persName>:</note><rubric>Mafei Vegii Laudensis de agno</rubric>
                  </msItem>
                  <msItem n="3" xml:id="MS_Canon_Misc_12-item3">
                     <locus from="13v">fol. 13v</locus>
                     <author key="person_95147024">Jerome</author>
                     <title key="work_2426">Ep. 20 ad Damasum</title><note>(prologue to the New Testament)</note>
                  </msItem>
                  <msItem n="4" xml:id="MS_Canon_Misc_12-item4">
                     <locus from="15r">fol. 15</locus>
                     <author key="person_39382430">Francesco Petrarca</author>
                     <title>Carmen in laude beatissime Mariae Magdalene (Rer. senil. XV 15 app.)</title>
                     <rubric>Franciscus Petrarcha poeta stetit tribus diebus in spelunca sancte
                        Marie Magdalene, ubi istos versus composuit.</rubric>
                     
                  </msItem>
                  <msItem n="5" xml:id="MS_Canon_Misc_12-item5">
                     <locus from="15v">fol. 15v</locus>
                     <author key="person_39382430" cert="low">Francesco Petrarca</author>
                     <title key="work_3552">Africa</title>
                     <note>Extract: VI 885-918, De morte Magonis</note>
                     
                  </msItem>
                  <msItem n="6" xml:id="MS_Canon_Misc_12-item6">
                     <locus from="17r">fol. 21r (Coxe 17r)</locus>
                     <title type="desc" key="work_15014" >Anonymous treatise on the ars dictaminis</title>
                     <incipit>Divisio personarum. Personarum quidem alie sunt excellentes, alie
                        infime, alie mediocres.</incipit>
                  </msItem>
                  <msItem n="7" xml:id="MS_Canon_Misc_12-item7">
                     <locus from="24v">fol. 28v (Coxe 24v)</locus>
                     <author key="person_79253953">Gasparino Barzizza</author>
                     <title key="work_7556">Exempla epistularum orationumque exordiorum siue Exordia</title>
                     <rubric>Exordia clarissimi oratoris M. Gasparini Pergamensis</rubric>
                     <rubric>In primis; In genere dubio.</rubric>
                     <incipit>Gaudeo plurimum ac letor in ea te sententia esse.</incipit>
                     <explicit>inaudita suavitate refertos dimisit. Amen: Gritle.</explicit>
                     <finalRubric>Expliciunt exordia clarissimi oratoris Gasparini Pergamensis;
                       </finalRubric><colophon> Amen: Gritle.</colophon>
                     <listBibl><bibl>Wrongly listed Bertalot, <title>Prosa</title>, 7913, as an example of the following work. The opening examples are taken from the <title>Epistolae ... accomodatae</title> so the incipit is identical. Not to be confused with the different <title>Exordia (Exempla orationum exordiorum)</title> pr. Padua 1483 (<ref target="https://data.cerl.org/istc/ib00268000">ISTC ib00268000</ref>).</bibl></listBibl>
                  </msItem>
                  <msItem n="8" xml:id="MS_Canon_Misc_12-item8">
                     <locus from="51r">fol. 55r (Coxe 51r)</locus>
                     <author key="person_79253953">Gasparino Barzizza</author>
                     <title key="work_1632">Epistolae ad exercitationem accomodatae</title>
                     <rubric>Epistole clarissimi oratoris Gasparini
                        Pergamensis</rubric>
                     <note>Thirty-four letters.</note>
                     <listBibl><bibl>Bertalot, <title>Prosa</title>, 7913</bibl></listBibl>
                  </msItem>
                  <msItem n="9" xml:id="MS_Canon_Misc_12-item9">
                     <locus from="67v">fol. 71v (Coxe 67v)</locus>
                     <author key="person_79253953">Gasparino Barzizza (?)</author>
                     <title key="work_7559">De doctrina punctandi</title>
                     <incipit>Ad evidenciam doctrine punctandi.</incipit>
                     <explicit>defunctis dicta sufficiant </explicit><colophon>Amen. Gritle.</colophon>
                     <listBibl><bibl>Bertalot, <title>Prosa</title>, 599, cites this manuscript</bibl></listBibl>
                  </msItem>
                  <msItem n="10" xml:id="MS_Canon_Misc_12-item10">
                     <locus from="70v">fol. 74v (Coxe 70v)</locus>
                     <author key="person_79253953">Gasparino Barzizza (?)</author>
                     <title key="work_7558">De arte punctandi</title>
                     <incipit>Notandum est secundum Catholic<ex>on</ex>.</incipit>
                     <explicit>illam dictionem. Amen. Gritle.</explicit>
                     <finalRubric>Explicit de arte punctandi composita per magistrum Gasparinum
                        Pergamensem et Gritle.</finalRubric>
                     <listBibl><bibl>Bertalot, <title>Prosa</title>, 14142, cites this manuscript and one other (Venice, Mus. Civ. Correr 1039, fols. 71-72).</bibl></listBibl>
                  </msItem>

